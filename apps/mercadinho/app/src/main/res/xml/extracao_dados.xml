<?xml version="1.0" encoding="utf-8"?>
<!-- Os dados do comerciante não vão para a nuvem do Google: backup é feito pelo próprio app. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
